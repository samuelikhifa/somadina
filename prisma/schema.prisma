generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model Lead {
  id        String   @id @default(cuid())
  email     String?  
  whatsapp  String?  
  source    String   @default("landing_page")
  createdAt DateTime @default(now())

  @@index([createdAt])
}